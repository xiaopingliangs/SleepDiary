{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sleepdiary.local/schemas/backup-v3.1.schema.json",
  "title": "SleepDiary BACKUP_3.1",
  "type": "object",
  "required": [
    "exportFormatVersion",
    "appVersion",
    "exportedAtUtc",
    "diarySchemaVersion",
    "safetySchemaVersion",
    "safetyRuleVersion",
    "weeklySummaryRuleVersion",
    "cbtiProtocolVersion",
    "diaryEntries",
    "safetyAssessments",
    "weeklySummaries",
    "trackingState",
    "workspaceSchemaVersion",
    "workspaceRecords",
    "inputSnapshots",
    "treatmentDataSchemaVersion",
